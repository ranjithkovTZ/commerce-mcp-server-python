    # Registers an OAuth2 client in SAP Commerce Cloud for this MCP server's OCC
    # (BACKEND_MODE=OCC) direct-backend mode — no BTP required.
    #
    # How to run:
    #   HAC > Console > ImpEx Import > paste this file (or upload it), then Import.
    #   (Or via your CI/CD data-import step, e.g. an OCC/CCv2 impex import job.)
    #
    # Before running:
    #   1. $clientSecret below is a literal value meant for local/dev use only —
    #      replace it with your own strong, randomly generated secret before
    #      importing anywhere real, and never commit a real production secret
    #      to this repo.
    #   2. Confirm with your Commerce Cloud admin whether OAuthClientDetails.clientSecret
    #      must be pre-encoded (e.g. a "{bcrypt}..." prefix) for your tenant's
    #      OAuth2 configuration, or whether plaintext is accepted as-is (OOTB
    #      default). Adjust $clientSecret accordingly if pre-encoding is required.
    #   3. $resourceId ("hybris") matches SAP Commerce's OOTB authorizationserver
    #      default — only change it if your tenant's commercewebservices/
    #      authorizationserver config uses a different resource id.
    #   4. $redirectUri MUST exactly match this MCP server's own
    #      MCP_PUBLIC_BASE_URL + "/occ/auth/callback" (see .env-template) for
    #      whichever environment you're importing against — a mismatch here is a
    #      common "redirect_uri_mismatch" failure. During local development (this
    #      server and Claude Desktop both running on your own machine) this is
    #      legitimately a localhost value, e.g. http://localhost:8000/occ/auth/callback
    #      — update and re-import this file whenever MCP_PUBLIC_BASE_URL changes
    #      (e.g. moving from local dev to a real cloud deployment).
    #
    # After running, set these in the MCP server's .env (see .env-template):
    #   OCC_CLIENT_ID=<$clientId value below>
    #   OCC_CLIENT_SECRET=<the real secret you set in $clientSecret>
    #   OCC_SCOPE=basic   (this MCP server only ever requests "basic"; only set
    #                      this if your tenant enforces scope validation)
    #
    # Note — this client is registered broader than the anonymous client_credentials
    # flow alone needs: scope "basic,extended,openid", grant types
    # "client_credentials,authorization_code,refresh_token,password", and
    # authority ROLE_TRUSTED_CLIENT (privileged — see SAP's guidance to avoid
    # granting it beyond what's actually required). This is intentional: the same
    # client is now reused for TWO flows —
    #   (a) client_credentials, scope=basic — the existing anonymous
    #       product-browsing tools (get_products, get_product_details, ...).
    #   (b) authorization_code, via registeredRedirectUri below — the
    #       get_customer_orders tool's per-CS-agent browser login (OAuthProxy in
    #       server.py). Each agent authenticates as themselves against this same
    #       client; OCC's own authorization (based on that specific agent's real
    #       permissions) decides what they can see, not this client's authorities.
    # Known tradeoff of sharing one client across both flows: rotating
    # $clientSecret affects both at once, and ROLE_TRUSTED_CLIENT is broader than
    # flow (b) strictly needs. If that ever becomes a problem, split into a
    # second, dedicated OAuthClientDetails row for flow (b) with a narrower
    # ROLE_CLIENT authority and its own secret — not needed for the initial build.

    $clientId=mcp-commerce-client
    $clientSecret=mcp_client@123
    $resourceId=hybris
    $redirectUri=http://localhost:8000/occ/auth/callback

    # OAuth client for MCP server (client_credentials, authorization_code, refresh_token, password grants)
    INSERT_UPDATE OAuthClientDetails; clientId[unique = true]; resourceIds; scope                ; authorizedGrantTypes                                      ; authorities  ; clientSecret     ; registeredRedirectUri
                                    ; $clientId           ; $resourceId     ; basic,extended,openid ; client_credentials,authorization_code,refresh_token,password ; ROLE_TRUSTED_CLIENT ; $clientSecret ; $redirectUri