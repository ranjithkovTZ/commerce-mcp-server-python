ENVIRONMENT=local
# BACKEND_MODE=mock|BTP|OCC (case-insensitive). No value set -> defaults to BTP.
BACKEND_MODE=mock
PORT
XSUAA_SERVICE_NAME
MCP_URL
MCP_TOKEN
MCP_TOOL

# BTP Destination + Commerce OData API
DESTINATION_NAME=
DESTINATION_SERVICE_INSTANCE_NAME=
COMMERCE_PRODUCTS_PATH=/Products

# OCC backend (BACKEND_MODE=OCC) — SAP Commerce Cloud native REST API, no BTP
# Token endpoint is always {OCC_BASE_URL}/authorizationserver/oauth/token — not separately configurable.
OCC_BASE_URL=
OCC_CLIENT_ID=
OCC_CLIENT_SECRET=
OCC_SCOPE=
OCC_BASE_SITE_ID=
WEBSITE_URL=

# CS-agent OAuth login for get_customer_orders/get_order_details (BACKEND_MODE=OCC,
# PORT set) — agents authenticate as themselves via OCC's hosted login page.
# Reuses OCC_CLIENT_ID/SECRET above; no separate OAuth client needed.

# This server's own reachable base URL. Local: http://localhost:<PORT>.
# Real deployment: a real HTTPS URL CS agents' clients and OCC can both reach.
MCP_PUBLIC_BASE_URL=

# Comma-separated redirect URI patterns allowed during client registration.
# Leave unset for local testing; set explicitly before any real deployment.
MCP_ALLOWED_CLIENT_REDIRECT_URIS=

# true only if your tenant's authorizationserver supports PKCE — check
# {OCC_BASE_URL}/authorizationserver/.well-known/openid-configuration for
# "code_challenge_methods_supported": ["S256"]. Default false is always safe.
OCC_SUPPORTS_PKCE=false