ENVIRONMENT=local
# BACKEND_MODE=mock|BTP|OCC (case-insensitive). No value set -> defaults to BTP.
BACKEND_MODE=mock
PORT
XSUAA_SERVICE_NAME
MCP_URL
MCP_TOKEN
MCP_TOOL

# BTP Destination + Commerce OData API
DESTINATION_NAME=
DESTINATION_SERVICE_INSTANCE_NAME=
COMMERCE_PRODUCTS_PATH=/Products

# OCC backend (BACKEND_MODE=OCC) — SAP Commerce Cloud native REST API, no BTP
OCC_BASE_URL=
OCC_TOKEN_URL=
OCC_CLIENT_ID=
OCC_CLIENT_SECRET=
OCC_SCOPE=
OCC_BASE_SITE_ID=
OCC_FIELDS=
OCC_PAGE_SIZE=
OCC_LANG=
OCC_CURRENCY=